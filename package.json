{
  "name": "sotay-banhang",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sổ tay bán hàng tạp hoá — quét mã vạch, nhớ giá, chốt sổ ngày/tuần, hai người bán cùng lúc",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "android:patch": "node scripts/patch-android.mjs",
    "apk": "npm run build && cap sync android && node scripts/patch-android.mjs && cd android && ./gradlew assembleDebug",
    "catalog": "node scripts/make-catalog.mjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^6.1.0",
    "@capacitor-mlkit/barcode-scanning": "^6.2.0",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/app-launcher": "^6.0.4",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/preferences": "^6.0.4",
    "@supabase/supabase-js": "^2.112.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "vite": "^8.2.2"
  }
}
